# Go server listener. Dual-stack by default.
LISTEN_ADDR=[::]:8080
PUBLIC_BASE_URL=https://call.example.com

# In-memory room lifecycle.
ROOM_TTL=2h
EMPTY_ROOM_GRACE=45s
SHUTDOWN_TIMEOUT=10s
DEV_DIAGNOSTICS=false

# Abuse limits for the unauthenticated room-creation endpoint.
# MAX_ROOMS caps rooms held in memory (0 disables the cap).
# ROOM_CREATE_RATE is sustained rooms per second per client; 0 disables limiting.
# ROOM_CREATE_BURST is how many a client may create back to back.
MAX_ROOMS=5000
ROOM_CREATE_RATE=0.2
ROOM_CREATE_BURST=5

# Set only when a trusted reverse proxy (for example Caddy) fronts the server.
# When true the last X-Forwarded-For entry identifies the client for rate
# limiting. Leave false if the server is exposed directly, or clients can forge
# the header and bypass the limit.
TRUST_PROXY_HEADERS=true

# STUN and TURN servers.
# The same coturn instance can provide both STUN and TURN.
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Must match static-auth-secret in deploy/coturn.conf.
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_CREDENTIAL_TTL=1h

# Optional alternative/additional ICE server objects.
# Example:
# ICE_SERVERS_JSON=[{"urls":["stun:stun.example.com:3478"]}]
ICE_SERVERS_JSON=[]
